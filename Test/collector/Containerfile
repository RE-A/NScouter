# Scouter Collector 2.21.3
# 콜렉터는 직접 빌드하지 않고 공식 릴리스 바이너리(vendor/scouter/server)를 그대로 사용한다.
FROM eclipse-temurin:17-jre

# 콜렉터는 XLog/프로파일을 **자기 타임존 기준 날짜 디렉토리**에 저장한다
# (/data/database/20260814). 클라이언트는 로컬 날짜로 조회하므로
# (ASIS DateUtil.yyyymmdd 도 동일) 둘이 어긋나면 프로파일이 조용히 0건이 된다.
# 컨테이너 기본값 UTC 를 두면 KST 00~09 시에 하루가 밀린다.
#
# compose 의 environment: 로는 podman-compose 1.6.0 에서 전달되지 않아 이미지에 굽는다.
ENV TZ=Asia/Seoul

WORKDIR /scouter/server

COPY vendor/scouter/server/ ./
COPY collector/conf/scouter.conf ./conf/scouter.conf

RUN mkdir -p /data/database /data/logs

EXPOSE 6100/tcp 6100/udp

# --add-opens / --add-exports 없이는 JDK 11+ 에서 JAXB Injector 초기화 실패로 기동하지 못한다.
#   java.lang.NoSuchMethodException: sun.misc.Unsafe.defineClass(...)
#   -> ExceptionInInitializerError at scouter.server.Configure.<clinit>
ENTRYPOINT ["java", "-Xmx1024m", \
    "--add-opens=java.base/java.lang=ALL-UNNAMED", \
    "--add-exports=java.base/sun.net=ALL-UNNAMED", \
    "-classpath", "./scouter-server-boot.jar", \
    "scouter.boot.Boot", "./lib"]
